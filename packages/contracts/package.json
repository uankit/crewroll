{
  "name": "@crewroll/contracts",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.13.0 <23"
  },
  "exports": {
    ".": "./openapi/index.ts",
    "./openapi": "./openapi/index.ts",
    "./fixtures/http": "./fixtures/http.ts",
    "./crypto/protocol": "./crypto/protocol.ts",
    "./native/protocol": "./native/protocol.ts",
    "./storage/ports": "./storage/ports.ts",
    "./generated/crewroll.openapi.json": "./generated/crewroll.openapi.json"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "openapi:generate": "tsx generator/generate-openapi.ts",
    "openapi:check": "tsx generator/check-openapi.ts"
  },
  "dependencies": {
    "@sinclair/typebox": "0.34.52"
  },
  "devDependencies": {
    "@types/node": "22.19.15",
    "tsx": "4.23.12",
    "typescript": "6.0.3",
    "vitest": "4.1.11"
  }
}
