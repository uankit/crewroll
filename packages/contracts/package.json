{
  "name": "@crewroll/contracts",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.13.0 <23"
  },
  "files": [
    "dist",
    "generated/crewroll.openapi.json"
  ],
  "exports": {
    ".": {
      "types": "./dist/openapi/index.d.ts",
      "import": "./dist/openapi/index.js"
    },
    "./openapi": {
      "types": "./dist/openapi/index.d.ts",
      "import": "./dist/openapi/index.js"
    },
    "./fixtures/http": {
      "types": "./dist/fixtures/http.d.ts",
      "import": "./dist/fixtures/http.js"
    },
    "./crypto/protocol": {
      "types": "./dist/crypto/protocol.d.ts",
      "import": "./dist/crypto/protocol.js"
    },
    "./native/protocol": {
      "types": "./dist/native/protocol.d.ts",
      "import": "./dist/native/protocol.js"
    },
    "./storage/ports": {
      "types": "./dist/storage/ports.d.ts",
      "import": "./dist/storage/ports.js"
    },
    "./generated/crewroll.openapi.json": "./generated/crewroll.openapi.json"
  },
  "scripts": {
    "build": "node ../../tools/clean-workspace-dist.mjs && tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "npm run build && vitest run",
    "openapi:generate": "tsx generator/generate-openapi.ts",
    "openapi:check": "tsx generator/check-openapi.ts"
  },
  "dependencies": {
    "@sinclair/typebox": "0.34.52"
  },
  "devDependencies": {
    "@types/node": "22.19.15",
    "tsx": "4.23.12",
    "typescript": "6.0.3",
    "vitest": "4.1.11"
  }
}
