# Expo 57 inlines EXPO_PUBLIC values into the client bundle. These are public
# transport coordinates only; never put the trip secret or relay credentials here.
EXPO_PUBLIC_AIRMESH_TRANSPORT=relay
EXPO_PUBLIC_AIRMESH_RELAY_URL=wss://relay.example.com/v1/relay

# Local development only. Production relay builds must use WSS.
# EXPO_PUBLIC_AIRMESH_ALLOW_INSECURE_RELAY=true
