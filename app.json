{
  "expo": {
    "name": "CrewRoll",
    "slug": "AirMesh",
    "version": "0.2.0",
    "orientation": "portrait",
    "platforms": [
      "ios",
      "android"
    ],
    "icon": "./assets/brand/app-icon.png",
    "scheme": "airmesh",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/brand/app-icon.png",
      "bundleIdentifier": "com.uankit53.airmesh",
      "supportsTablet": false
    },
    "android": {
      "allowBackup": false,
      "adaptiveIcon": {
        "backgroundColor": "#020A12",
        "foregroundImage": "./assets/brand/app-icon.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.INTERNET",
        "android.permission.READ_MEDIA_IMAGES"
      ],
      "blockedPermissions": [
        "android.permission.SYSTEM_ALERT_WINDOW",
        "android.permission.WRITE_EXTERNAL_STORAGE"
      ],
      "package": "com.uankit53.airmesh"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#020A12",
          "image": "./assets/brand/app-icon.png",
          "imageWidth": 112
        }
      ],
      [
        "expo-media-library",
        {
          "photosPermission": "CrewRoll automatically finds new eligible photos added during an active trip so it can share them privately with your group.",
          "savePhotosPermission": "CrewRoll saves verified exact originals from your active trip to your photo library.",
          "granularPermissions": [
            "photo"
          ],
          "isAccessMediaLocationEnabled": false
        }
      ],
      [
        "expo-secure-store",
        {
          "configureAndroidBackup": false,
          "faceIDPermission": false
        }
      ],
      "@clerk/expo"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "fe1de141-5c42-4250-9c1f-f7313845dc8e"
      }
    },
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/fe1de141-5c42-4250-9c1f-f7313845dc8e"
    }
  }
}
